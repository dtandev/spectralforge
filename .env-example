# ============================================================
# TerraEye S&I Project — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env-example .env
#
# NEVER commit .env to the repository.
# ============================================================

# --- General ---
ENV=development                     # development | staging | production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR

# --- Data paths ---
INPUT_DATA_DIR=./data/input         # Path to input data directory
OUTPUT_DATA_DIR=./data/output       # Path to output data directory

# --- SpectralHub database connection ---
# Same DB the spectralhub library connects to (see spectralhub/secrets.json keys
# USER_NAME/PASSWORD/HOST/PORT/DBNAME for the production Azure instance — never copy
# those real values here or into this repo; for local dev, point at db/docker-compose.yml
# instead: DB_USER=spectralforge, DB_PASSWORD=spectralforge_dev_only, DB_HOST=localhost,
# DB_PORT=5433, DB_NAME=spectralforge_dev)
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_db_name

# --- External APIs ---
# TODO: Add API keys needed by this project
# SOME_API_KEY=your_api_key_here
# ANOTHER_SERVICE_TOKEN=your_token_here

# --- Notion ---
# NOTION_API_TOKEN=your_notion_integration_token
# NOTION_DATABASE_ID=your_knowledge_base_database_id

# --- Optional: Cloud storage ---
# AWS_ACCESS_KEY_ID=your_key
# AWS_SECRET_ACCESS_KEY=your_secret
# AWS_DEFAULT_REGION=eu-central-1
